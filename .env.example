# ── AWS Bedrock — Claude Sonnet 4.6 via LiteLLM ───────────────────────────────
# A cross-region inference profile is REQUIRED: us-east-1 has NO in-region inference
# for Sonnet 4.6, and the bare model id errors on on-demand throughput.
#   us.     = Geo US (routes within US/Canada regions)  ← default
#   global. = routes worldwide (max availability, no data-residency guarantee)
BEDROCK_MODEL_ID=bedrock/us.anthropic.claude-sonnet-4-6
# Phase 2 load/cross-talk testing: Haiku is cheaper+faster (more overlap per run). Switch via
# this env var. VERIFY the exact cross-region inference-profile id in the Bedrock model catalog
# before trusting it (Phase 1 was bitten by a bad id — DEC-1). Likely candidate:
#   BEDROCK_MODEL_ID=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0

# AWS SSO (recommended for personal/lab). Run `aws sso login --profile mainadmin` first.
AWS_PROFILE=mainadmin
AWS_REGION=us-east-1

# Or static creds (CI):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# ── Atlassian Rovo MCP OAuth ──────────────────────────────────────────────────
# Loopback port for the OAuth callback server (must be free on first run).
ATLASSIAN_OAUTH_CALLBACK_PORT=3030

# ── Phase 2: session store (multi-user forwarding agent) ──────────────────────
# Where ADK conversation history lives. The forwarded bearer is NEVER stored here — only the
# non-secret bound accountId + client label — so any backend is credential-free.
#   memory   = in-process (default; single container — fine for the cross-talk test unit)
#   sqlite   = single-host file persistence (set SESSION_DB_PATH)
#   database = shared across autoscaled tasks (set SESSION_DB_URL; needs sqlalchemy + a DB)
SESSION_BACKEND=memory
# SESSION_DB_PATH=./sessions.db
# SESSION_DB_URL=postgresql+psycopg://user:pass@host:5432/agent

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Prompt caching ────────────────────────────────────────────────────────────
# The agent prompt-caches its static prefix (tool schemas + the SKILL.md system prompt) via
# LiteLLM's cache_control_injection_points — no setting required for the primary path. Only
# if the per-call token-usage log shows cached(read) stuck at 0, flip this to 1 to use the
# fallback that injects cache_control directly via a LiteLLMClient subclass.
ATLASSIAN_CACHE_FALLBACK=0
