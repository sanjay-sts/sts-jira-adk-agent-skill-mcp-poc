# ── AWS Bedrock — Claude Sonnet 4.6 via LiteLLM ───────────────────────────────
# A cross-region inference profile is REQUIRED: us-east-1 has NO in-region inference
# for Sonnet 4.6, and the bare model id errors on on-demand throughput.
#   us.     = Geo US (routes within US/Canada regions)  ← default
#   global. = routes worldwide (max availability, no data-residency guarantee)
BEDROCK_MODEL_ID=bedrock/us.anthropic.claude-sonnet-4-6

# AWS SSO (recommended for personal/lab). Run `aws sso login --profile mainadmin` first.
AWS_PROFILE=mainadmin
AWS_REGION=us-east-1

# Or static creds (CI):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# ── Atlassian Rovo MCP OAuth ──────────────────────────────────────────────────
# Loopback port for the OAuth callback server (must be free on first run).
ATLASSIAN_OAUTH_CALLBACK_PORT=3030

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
