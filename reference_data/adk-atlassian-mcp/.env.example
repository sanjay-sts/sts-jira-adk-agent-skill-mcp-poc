# AWS Bedrock — Claude Sonnet 4.6 via LiteLLM
# Use AWS SSO (recommended for personal/lab):
AWS_PROFILE=mainadmin
AWS_REGION=us-east-1

# Or static creds (for CI):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# Override the Bedrock model ID if needed
# BEDROCK_MODEL_ID=bedrock/anthropic.claude-sonnet-4-6-20250929-v1:0

# Logging
LOG_LEVEL=INFO
